"""classify_objects_by_language -- r0B_lean: minimal act-observe-retry loop.

Inputs: native instruction, head RGB-D (+calibration), encoders/URDF FK, native IK. No route search.

Loop:  start  (arms swung out of the head view; park joints chosen by URDF FK + camera projection)
       -> survey (ONE grounding call: baskets + loose objects; Claude maps each object to the
                  left/middle/right basket from the instruction)
       -> route  (pick the next loose object; bounded attempts per spot; action reserve for homing)
       -> act    (direct top-down grasp, lift, carry, drop over its basket, re-park the arm)
       -> survey ... (the next survey is the camera check of the previous place)
       -> finish (both arms to start joints, grippers open).
"""
from __future__ import annotations

import numpy as np

from agraph.contract import ABORT, DONE, FAIL, PASS, UNKNOWN, BudgetExhausted, EvidenceUnavailable, Graph, Node, \
    NodeResult
from agraph.vendor.perception_geometry import backproject, infer_geometry, project
from agraph.vendor.robot_io import IKFailure

TASK_ID = 'classify_objects_by_language'
SIDES = ('left', 'middle', 'right')

IMAGE_CONTRACT = (
    'Image contract: exactly ONE image is supplied (the file listed below); open it with the Read tool. No '
    'other tool or file is available: do not run commands and do not crop, enlarge or save copies.')


def parse_assignment(instruction):
    """'Put car objects into the left basket, watch objects into the middle basket, ...' -> {category: side}."""
    import re
    out = {}
    for cat, side in re.findall(r'([A-Za-z][A-Za-z_ -]*?)\s+objects?\s+into\s+the\s+(left|middle|right)\s+basket',
                                str(instruction), flags=re.I):
        cat = re.sub(r'^(and|put|then)\s+', '', cat.strip().lower()).strip().replace(' ', '_')
        out[cat] = side.lower()
    return out


def norm_category(word, cats):
    """Map a free-form category word onto one of the instruction categories (or None)."""
    w = str(word or '').strip().lower().replace(' ', '_').replace('-', '_')
    if len(w) < 3:
        return None
    if w in cats:
        return w
    for c in cats:
        if w.rstrip('s') == c.rstrip('s') or w.startswith(c) or (c.startswith(w.rstrip('es')) and len(w) > 2):
            return c
    for c in cats:
        if c.replace('_', '') in w.replace('_', '') or w.replace('_', '') in c.replace('_', ''):
            return c
    return None


class _Row:
    """Minimal stand-in for a grounded row (SAM-only relocalisation)."""

    def __init__(self, label, geometry, attributes, box_xyxy, frame):
        self.label, self.geometry, self.attributes, self.box_xyxy, self.frame = label, geometry, attributes, box_xyxy, frame
        self.center = np.asarray(geometry['center'], float)
        self.top_z = float(geometry['top_z'])

QUERY = ('each of the three large open baskets (label "basket", attributes {"role": "basket"}) AND every small object, '
         'both the loose ones lying on the table and the ones already inside a basket (attributes {"role": "object", '
         '"category": its category word from the task instruction, "basket": "left" | "middle" | "right" = the basket '
         'the task instruction assigns to that category}). Do NOT list robot parts or the table. '
         'Left/right/middle refer to the baskets as seen in this image.')
QUERY_FINAL = QUERY + (' Look very carefully for small or flat objects still lying on the table, especially right in '
                       'front of, beside or leaning against a basket wall; list every one of them.')


def P(ctx, key, default):
    return ctx.params.get('lean', {}).get(key, default)


# ---------------------------------------------------------------- zero-API perception (SAM3 + depth, no Claude)
class _NoRemoteAgent:
    """ctx.agent in zero-API mode: any remote semantic question is refused (never reaches the mailbox)."""
    calls = ()

    def ask(self, purpose, prompt, images=(), schema=None):
        from agraph.mailbox import SemanticUnavailable
        raise SemanticUnavailable(f'zero-API controller: remote semantic call "{purpose}" refused')


class _LocalGroundAgent:
    """perception.agent in zero-API mode. Answers ONLY the 'ground' purpose, for the head frame perception has just
    captured (perception._last), from local SAM3 text prompts + that frame's depth (local_ground.survey): baskets and
    objects with their instruction category. Boxes then go through the unchanged SAM2 -> depth geometry path."""

    def __init__(self, ctx):
        self.ctx = ctx
        self.n = 0

    def _seg(self):
        from agraph.sam3_raw_client import Sam3Client
        client = self.ctx.facts.get('sam3_client')
        if client is None:
            client = self.ctx.facts['sam3_client'] = Sam3Client(**dict(P(self.ctx, 'sam3_client', {})))
        return lambda img, phrases: _sam3_raw(client, img, phrases)

    def ask(self, purpose, prompt, images=(), schema=None):
        import json as _json
        import time as _time
        from agraph.mailbox import SemanticUnavailable
        from . import local_ground as lg
        f = self.ctx.perception._last
        if purpose != 'ground' or f is None or not images or str(images[0]) != str(f['rgb_path']):
            raise SemanticUnavailable(f'local grounding answers only head "ground" on the current frame ({purpose})')
        cats = list(_assignment(self.ctx))
        t0 = _time.time()
        try:
            baskets, objects, info = lg.survey(self._seg(), f['rgb'], f['depth'], f['K'], f['T_world_camera'], cats,
                                               dict(P(self.ctx, 'local_ground', {})))
        except Exception as exc:  # noqa: BLE001 - SAM3 service down / malformed answer: survey retries
            self.ctx.log('lean_local_ground', frame=f['frame'], error=f'{type(exc).__name__}: {exc}'[:300])
            raise SemanticUnavailable(f'local SAM3 grounding failed: {exc}') from exc
        self.n += 1
        inst = [dict(label='basket', box_xyxy=b['box_xyxy'], attributes={'role': 'basket'}) for b in baskets]
        for o in objects:
            a = o['attributes']
            inst.append(dict(label=o['label'], box_xyxy=o['box_xyxy'],
                             attributes=dict(role='object', category=a['category'], fused=a.get('fused'),
                                             mosaic=a.get('mosaic'), in_basket=a.get('in_basket'))))
        rec = dict(frame=f['frame'], seconds=round(_time.time() - t0, 2), cats=cats, n_baskets=len(baskets),
                   objects=[dict(label=o['label'], box=o['box_xyxy'], fused=o['attributes'].get('fused'),
                                 geom=o['attributes'].get('geom'), near=o['attributes'].get('near_basket'),
                                 in_basket=o['attributes'].get('in_basket')) for o in objects],
                   rejected=info.get('rejected'), table_z=info.get('table_z'))
        (f['directory'] / 'local_ground.json').write_text(_json.dumps(rec, default=float))
        self.ctx.log('lean_local_ground', **{k: v for k, v in rec.items() if k != 'rejected'},
                     n_rejected=len(info.get('rejected') or []))
        return dict(instances=inst)


def _sam3_raw(client, img, phrases):
    """local_vision SAM3 text prompts -> {phrase: {'dets': [dict(score, box, mbox, mask)]}} (local_ground format)."""
    return client.raw_dets(np.asarray(img, np.uint8), list(phrases))


def _zero_api(ctx):
    return bool(P(ctx, 'zero_api', True))


# ---------------------------------------------------------------- low-level motion (generators, one native action per yield)
def _seg_dist(a0, a1, b0, b1):
    """Min distance between XY segments a0-a1 and b0-b1."""
    a0, a1, b0, b1 = (np.asarray(v, float)[:2] for v in (a0, a1, b0, b1))

    def pt(p, s0, s1):
        d = s1 - s0
        t = 0. if float(d @ d) < 1e-12 else float(np.clip((p - s0) @ d / (d @ d), 0., 1.))
        return float(np.linalg.norm(p - (s0 + t * d)))
    da, db = a1 - a0, b1 - b0
    den = da[0] * db[1] - da[1] * db[0]
    if abs(den) > 1e-12:
        w = b0 - a0
        s = (w[0] * db[1] - w[1] * db[0]) / den
        u = (w[0] * da[1] - w[1] * da[0]) / den
        if 0 <= s <= 1 and 0 <= u <= 1:
            return 0.
    return min(pt(a0, b0, b1), pt(a1, b0, b1), pt(b0, a0, a1), pt(b1, a0, a1))


class Motion:
    """Motions are generators: each ``yield`` = this arm's command for ONE native action is set. ``run`` drives
    one generator per arm in lock-step, so both arms move in the same native actions. While two arms run, every
    single-arm move first waits until its XY TCP sweep keeps ``gap`` from the other arm's reserved sweep."""

    def __init__(self, ctx):
        self.ctx = ctx
        self.sk = ctx.skills
        self.io = ctx.skills.io
        self.home_q = {a: np.asarray(q, float).copy() for a, q in self.sk.home_q.items()}
        self.limits = {a: self._limits(a) for a in self.io.arms}
        self.events = []                 # (label, interpolation actions, settle actions) per jmove
        self.parallel = False
        self.res = {a: None for a in self.io.arms}
        self.waiting = {a: False for a in self.io.arms}
        self.prio = {}
        self.park = None
        self.gap = float(P(ctx, 'arm_gap', .16))
        self.line_gap = float(P(ctx, 'arm_line_gap', .10))
        self.wait_log = {a: 0 for a in self.io.arms}

    def _limits(self, arm):
        names = list(self.io.arms[arm].arm_joints_name)
        lo, hi = np.full(len(names), -np.inf), np.full(len(names), np.inf)
        for j in self.io._trees[arm].findall('joint'):
            if j.get('name') in names and j.find('limit') is not None:
                i = names.index(j.get('name'))
                lo[i] = float(j.find('limit').get('lower', -np.inf))
                hi[i] = float(j.find('limit').get('upper', np.inf))
        return lo, hi

    def guard(self):
        if self.io.stopped or self.io.action_count >= self.io.action_limit:
            raise BudgetExhausted()

    def run(self, gens):
        """Drive {key: generator}; one native action per round in which any generator yielded. Returns
        {key: generator return value}."""
        out, active = {}, dict(gens)
        try:
            while active:
                stepped = False
                for k in list(active):
                    try:
                        next(active[k])
                        stepped = True
                    except StopIteration as s:
                        out[k] = s.value
                        del active[k]
                        if k in self.res:
                            self.res[k] = None
                            self.waiting[k] = False
                if stepped:
                    self.guard()
                    self.io.step()
        finally:
            self.res = {a: None for a in self.io.arms}
            self.waiting = {a: False for a in self.io.arms}
        return out

    def do(self, gen):
        return self.run({'_': gen})['_']

    def _unwrap(self, arm, q, cur):
        lo, hi = self.limits[arm]
        alt = cur + (q - cur + np.pi) % (2 * np.pi) - np.pi
        return np.where((alt >= lo) & (alt <= hi), alt, q)

    def local_ik(self, arm, T, q0, iters=40):
        """Damped least squares on URDF FK from q0 (stays on q0's branch) for T or T turned by pi about the
        approach axis; returns q or None."""
        from scipy.spatial.transform import Rotation
        lo, hi = self.limits[arm]
        best = None
        for flip in (False, True):
            G = np.asarray(T, float).copy()
            if flip:
                G[:3, 1:3] *= -1
            q = np.asarray(q0, float).copy()
            for _ in range(iters):
                C = self.io.tcp(arm, q=q)
                e = np.r_[G[:3, 3] - C[:3, 3], .3 * Rotation.from_matrix(G[:3, :3] @ C[:3, :3].T).as_rotvec()]
                if np.linalg.norm(e[:3]) < .002 and np.linalg.norm(e[3:]) < .3 * .03:
                    break
                J = np.zeros((6, len(q)))
                for i in range(len(q)):
                    dq = np.zeros(len(q))
                    dq[i] = 1e-4
                    Ci = self.io.tcp(arm, q=q + dq)
                    J[:3, i] = (Ci[:3, 3] - C[:3, 3]) / 1e-4
                    J[3:, i] = .3 * Rotation.from_matrix(Ci[:3, :3] @ C[:3, :3].T).as_rotvec() / 1e-4
                step = J.T @ np.linalg.solve(J @ J.T + 1e-4 * np.eye(6), e)
                q = np.clip(q + step * min(1., .3 / max(float(np.max(np.abs(step))), 1e-9)), lo, hi)
            C = self.io.tcp(arm, q=q)
            pe = float(np.linalg.norm(G[:3, 3] - C[:3, 3]))
            re = float(Rotation.from_matrix(G[:3, :3] @ C[:3, :3].T).magnitude())
            if pe < .004 and re < .05:
                d = float(np.max(np.abs(q - q0)))
                if best is None or d < best[0]:
                    best = (d, q)
        return None if best is None else best[1]

    def ik_near(self, arm, T, max_jump=.8):
        """For short moves: native IK unless its nearest branch jumps > max_jump rad, then local DLS IK."""
        cur = self.io.joints(arm)
        try:
            q = self.ik(arm, T)
            if float(np.max(np.abs(q - cur))) <= max_jump:
                return q
        except IKFailure:
            q = None
        ql = self.local_ik(arm, T, np.asarray(self.io.q[arm], float))
        if ql is not None and q is not None and float(np.max(np.abs(ql - cur))) >= float(np.max(np.abs(q - cur))):
            ql = None                     # local solution is no nearer: keep the native one
        if ql is None and q is not None and float(np.max(np.abs(q - cur))) <= float(P(self.ctx, 'max_short_jump', 2.0)):
            return q
        if ql is not None:
            self.ctx.log('lean_local_ik', arm=arm, native_jump=None if q is None else float(np.max(np.abs(q - cur))),
                         local_jump=float(np.max(np.abs(ql - cur))))
            return ql
        raise IKFailure(dict(reason='joint_jump', arm=arm, jump=None if q is None else float(np.max(np.abs(q - cur)))))

    def ik_guarded(self, arm, T, max_jump=None):
        """Transit waypoint: native IK, but a branch jump > max_jump rad is replaced by local DLS IK when nearer."""
        max_jump = float(P(self.ctx, 'max_transit_jump', 2.0)) if max_jump is None else max_jump
        cur = np.asarray(self.io.q[arm], float)
        q = self.ik(arm, T)
        if float(np.max(np.abs(q - cur))) > max_jump:
            ql = self.local_ik(arm, T, cur, iters=60)
            if ql is not None and float(np.max(np.abs(ql - cur))) < float(np.max(np.abs(q - cur))):
                self.ctx.log('lean_local_ik', arm=arm, transit=True, native_jump=float(np.max(np.abs(q - cur))),
                             local_jump=float(np.max(np.abs(ql - cur))))
                return ql
        return q

    def ik(self, arm, T, ref=None):
        """Native IK (seeded at the current joints) for T and for T turned by pi about the approach axis
        (the parallel jaw is symmetric); each unwrapped to the 2*pi-equivalent nearest ``ref`` (default:
        current joints); returns the nearer one. Raises IKFailure only when both fail."""
        cur = self.io.joints(arm) if ref is None else np.asarray(ref, float)
        T = np.asarray(T, float)
        flip = T.copy()
        flip[:3, 1:3] *= -1
        best, err = None, None
        for G in (T, flip):
            try:
                q = self._unwrap(arm, np.asarray(self.io.solve(arm, G)['joint_value'], float), cur)
            except IKFailure as exc:
                err = exc
                continue
            if best is None or np.max(np.abs(q - cur)) < np.max(np.abs(best - cur)):
                best = q
        if best is None:
            raise err
        return best

    def cmove(self, arm, T_goal, q_goal=None, grip=None, step=.15, mids=2, bump=.02, label='', settle=12, tol=.012,
              acc=None, keep_rot=False):
        """Cartesian-ish transit (generator): a few intermediate TCP poses (linear position, slerped orientation,
        height not below the higher endpoint + bump) each solved at execution time, then the goal joints."""
        from scipy.spatial.transform import Rotation, Slerp
        T0 = self.io.tcp(arm)
        T1 = np.asarray(T_goal, float)
        slerp = Slerp([0, 1], Rotation.from_matrix([T0[:3, :3], T1[:3, :3]]))
        top = max(T0[2, 3], T1[2, 3])
        used = 0
        for k in range(1, int(mids) + 1):
            f = k / (mids + 1.)
            p = T0[:3, 3] * (1 - f) + T1[:3, 3] * f
            for b in (bump, 0.):
                Tm = self.pose([p[0], p[1], max(p[2], top + b)], T0[:3, :3] if keep_rot else slerp([f]).as_matrix()[0])
                try:
                    qm = self.ik_guarded(arm, Tm)
                except IKFailure:
                    continue
                used += yield from self.jmove({arm: qm}, grip=grip, step=step, settle=0, label=label + f'_mid{k}', acc=acc,
                                              through=bool(acc) and arm in getattr(self, 'v_chain', set()))
                break
        q_goal = self.ik_guarded(arm, T1) if q_goal is None else q_goal
        used += yield from self.jmove({arm: q_goal}, grip=grip, step=step, label=label, settle=settle, tol=tol, acc=acc)
        return used

    def _clear(self, arm, target_xy, label):
        """Generator: hold this arm until its XY sweep to target_xy is >= gap from the other arm's reservation.
        Deadlock (both waiting): the later-started arm detours to its park joints first."""
        other = [a for a in self.io.arms if a != arm]
        if not self.parallel or not other:
            return 0
        other = other[0]
        used, detoured = 0, False
        while True:
            p0 = self.io.tcp(arm)[:2, 3]
            o = self.res.get(other)
            if o is None:
                po = self.io.tcp(other)[:2, 3]
                o = (po, po)
            if not self.interferes(arm, p0, target_xy, other, o[0], o[1]):
                break
            if (self.waiting[other] and not detoured and self.park is not None
                    and self.prio.get(arm, 0) > self.prio.get(other, 0)):
                detoured = True
                self.waiting[arm] = False
                self.ctx.log('lean_detour', arm=arm, label=label)
                used += yield from self._raw(arm, self.park[arm], .22)
                continue
            self.waiting[arm] = True
            self.wait_log[arm] += 1
            used += 1
            if used > 400:
                raise IKFailure(dict(reason='arm_clearance_blocked', arm=arm, label=label))
            yield
        self.waiting[arm] = False
        self.res[arm] = (p0, np.asarray(target_xy, float)[:2])
        return used

    def interferes(self, arm, p0, p1, other, o0, o1):
        """XY interference: TCP sweeps closer than ``gap``, or the arm lines (base -> TCP, a proxy for the
        forearm footprint) of the two sweeps closer than ``line_gap``."""
        if _seg_dist(p0, p1, o0, o1) < self.gap:
            return True
        b, bo = self.io.base_transform(arm)[:2, 3], self.io.base_transform(other)[:2, 3]
        mine = [(b, p0), (b, p1), (p0, p1)]
        theirs = [(bo, o0), (bo, o1), (o0, o1)]
        return min(_seg_dist(a0, a1, c0, c1) for a0, a1 in mine for c0, c1 in theirs) < self.line_gap

    def _raw(self, arm, q, step):
        used = 0
        while True:
            d = np.asarray(q, float) - np.asarray(self.io.q[arm], float)
            m = float(np.max(np.abs(d)))
            if m < 1e-4:
                break
            self.io.q[arm] = np.asarray(self.io.q[arm], float) + d * min(1., step / max(m, 1e-9))
            used += 1
            yield
        p = self.io.tcp(arm, q=q)[:2, 3]
        self.res[arm] = (p, p)
        return used

    def jmove(self, goals, grip=None, step=.15, tol=.012, settle=12, label='', acc=None, through=False):
        """Generator: joint-space interpolation of the COMMANDED joints toward goals {arm: q}; each action moves
        every listed arm by at most ``step`` rad per joint; then hold until encoders are within ``tol`` (bounded)."""
        used = 0
        waits = 0
        if len(goals) == 1:
            (a1, q1), = goals.items()
            waits = yield from self._clear(a1, self.io.tcp(a1, q=np.asarray(q1, float))[:2, 3], label)
        for a, g in (grip or {}).items():
            self.io.g[a] = g
        a0 = next(iter(goals))
        chain = bool(acc) and len(goals) == 1 and a0 in getattr(self, 'v_chain', set())
        v = float(getattr(self, 'v_carry', {}).get(a0, 0.)) if chain else 0.
        while True:
            far = {a: np.asarray(q, float) - np.asarray(self.io.q[a], float) for a, q in goals.items()}
            worst = max(float(np.max(np.abs(d))) for d in far.values())
            if worst < 1e-4:
                break
            s_ = step
            if acc:                       # held object: trapezoidal ramp (no velocity jumps at start/stop)
                cap = step if through else float(np.sqrt(2 * acc * worst)) + .5 * acc
                v = max(min(step, v + acc, cap), acc)
                s_ = v
            for a, d in far.items():
                self.io.q[a] = np.asarray(self.io.q[a], float) + d * min(1., s_ / max(float(np.max(np.abs(d))), 1e-9))
            used += 1
            yield
        moved = used
        if not hasattr(self, 'v_carry'):
            self.v_carry = {}
        self.v_carry[a0] = v if (chain and through) else 0.
        for _ in range(int(settle)):
            err = max(float(np.max(np.abs(np.asarray(q) - self.io.joints(a)))) for a, q in goals.items())
            if err < tol:
                break
            used += 1
            yield
        for a, q in goals.items():
            if a in self.res:
                p = self.io.tcp(a, q=np.asarray(q, float))[:2, 3]
                self.res[a] = (p, p)
        tag = next(iter(goals)) if len(goals) == 1 else 'both'
        self.events.append((tag[0], label, moved, used - moved) if not waits else (tag[0], label, moved, used - moved, waits))
        return used + waits

    def hold(self, arm, grip, n):
        self.io.g[arm] = grip
        for _ in range(int(n)):
            yield
        return int(n)

    @staticmethod
    def pose(xyz, R):
        T = np.eye(4)
        T[:3, :3], T[:3, 3] = R, xyz
        return T


def yaw_rot(R, deg):
    c, s = np.cos(np.radians(deg)), np.sin(np.radians(deg))
    return np.array([[c, -s, 0], [s, c, 0], [0, 0, 1.]]) @ R


def pitched_frame(h, theta_deg, sign=1.):
    """Gripper frame (x = approach, y = closing) whose approach is pitched from straight down toward the
    horizontal direction ``h`` by theta (0 = top-down, 90 = horizontal, pointing along h)."""
    h = np.r_[np.asarray(h, float)[:2], 0.]
    h /= max(np.linalg.norm(h), 1e-9)
    t = np.radians(theta_deg)
    a = h * np.sin(t) - np.array([0., 0., 1.]) * np.cos(t)
    c = np.cross(h, [0., 0., 1.]) * sign
    return np.column_stack((a, c, np.cross(a, c)))


def reach(mo, arm, xyz, thetas, max_found=2, h=None):
    """IK over a pitch family toward ``h`` (default: from the arm base to xyz); among the first ``max_found``
    feasible poses return the one closest to the current joints: dict(q, T, theta) or None."""
    b = mo.io.base_transform(arm)[:3, 3]
    h = np.asarray(xyz[:2], float) - b[:2] if h is None else np.asarray(h, float)
    cur = mo.io.joints(arm)
    found = []
    for th in thetas:
        for sign in (1., -1.):
            T = Motion.pose(xyz, pitched_frame(h, th, sign))
            try:
                q = mo.ik(arm, T)
            except IKFailure:
                continue
            found.append(dict(q=q, T=T, theta=th, cost=float(np.max(np.abs(q - cur)))))
            break
        if len(found) >= max_found:
            break
    return min(found, key=lambda f: f['cost']) if found else None


# ---------------------------------------------------------------- park pose: arms out of the head view
def _arm_points(io, arm, q):
    tf = io.link_transforms(arm, q=q)
    origins = np.array([T[:3, 3] for T in tf.values()])
    pts = [origins]
    order = np.argsort(np.linalg.norm(origins - io.base_transform(arm)[:3, 3], axis=1))
    chain = origins[order]
    for a, b in zip(chain[:-1], chain[1:]):
        pts.append(a + (b - a) * np.linspace(0, 1, 8)[:, None])
    try:
        pts.append(io.hand_points(arm, io.tcp(arm, q=q))[::5])
    except Exception:  # noqa: BLE001 - hand mesh optional for this heuristic
        pass
    return np.concatenate(pts)


def choose_park(ctx, mo, frame):
    io = mo.io
    K, T = np.asarray(frame['K'], float), np.asarray(frame['T_world_camera'], float)
    table_z = float(P(ctx, 'table_z_guess', .765))
    roi = np.array([[x, y, table_z] for x in (-.48, .48) for y in (-.32, .12)])
    pix = project(roi, K, T)
    u0, v0 = pix.min(axis=0)
    u1, v1 = pix.max(axis=0)
    parks = {}
    for arm in io.arms:
        home = mo.home_q[arm]
        lo, hi = mo.limits[arm]
        side = float(np.sign(io.base_transform(arm)[0, 3])) or (-1. if arm == 'left' else 1.)
        home_x = float(io.tcp(arm, q=home)[0, 3])
        best = None
        for d0 in (0., .4, -.4, .7, -.7, 1.0, -1.0, 1.3, -1.3):
            for d1 in (0., -.3, .3, -.6):
                q = home.copy()
                q[0] += d0
                if len(q) > 1:
                    q[1] += d1
                if np.any(q < lo) or np.any(q > hi):
                    continue
                tcp = io.tcp(arm, q=q)[:3, 3]
                if side * tcp[0] < side * home_x - .05 or tcp[2] < table_z + .06:
                    continue
                pts = _arm_points(io, arm, q)
                pts = pts[pts[:, 2] > table_z + .005]
                uv = project(pts, K, T)
                inside = (uv[:, 0] > u0) & (uv[:, 0] < u1) & (uv[:, 1] > v0) & (uv[:, 1] < v1)
                occ = float(inside.sum()) / max(len(pts), 1)
                cost = occ * 10 + abs(d0) * .3 + abs(d1) * .3
                if best is None or cost < best[0]:
                    best = (cost, q, occ, d0, d1, tcp)
        parks[arm] = best[1] if best is not None else home.copy()
        ctx.log('lean_park', arm=arm, occ=None if best is None else best[2], d0=None if best is None else best[3],
                d1=None if best is None else best[4], tcp=None if best is None else best[5].round(3).tolist(),
                roi_px=[float(u0), float(v0), float(u1), float(v1)])
    return parks


# ---------------------------------------------------------------- nodes
def _start(ctx):
    mo = Motion(ctx)
    ctx.facts['motion'] = mo
    ctx.facts['attempts'] = []
    ctx.facts['baskets'] = None
    ctx.facts['survey_fail'] = 0
    if _zero_api(ctx):
        ctx.perception.agent = _LocalGroundAgent(ctx)
        ctx.agent = _NoRemoteAgent()
    frame = ctx.perception.observe('lean_start')
    parks = choose_park(ctx, mo, frame)
    ctx.facts['park'] = parks
    mo.park = parks
    ctx.facts['mis_prev'] = []
    ctx.facts['mis_pending'] = 0
    used = mo.do(mo.jmove(parks, grip={a: 1 for a in parks}, step=float(P(ctx, 'transit_step', .15))))
    return NodeResult(PASS, evidence=dict(park={a: q.tolist() for a, q in parks.items()}), actions=used)


def _xy_inside(obj_xy, basket_row, margin=0.):
    g = basket_row.geometry
    axes = np.asarray(g['axes'], float)
    local = (np.asarray(obj_xy, float) - np.asarray(g['center'][:2])) @ axes[:2, :2]
    half = np.asarray(g['extent'][:2], float) / 2 + margin
    return bool(np.all(np.abs(local) <= half))


def _survey(ctx):
    try:
        final = bool(ctx.facts.pop('final_check_pending', False))
        rows = ctx.perception.ground_all(QUERY_FINAL if final else QUERY, 'lean_survey_final' if final else 'lean_survey')
    except EvidenceUnavailable as exc:
        ctx.facts['survey_fail'] += 1
        status = FAIL if ctx.facts['survey_fail'] >= int(P(ctx, 'max_survey_fail', 3)) else UNKNOWN
        return NodeResult(status, 'survey_unavailable', dict(error=str(exc)[:300]))
    is_basket = [str(r.attributes.get('role', '')).lower() == 'basket' or r.label.lower().strip() == 'basket'
                 for r in rows]
    baskets = [r for r, b in zip(rows, is_basket) if b]
    objects = [r for r, b in zip(rows, is_basket) if not b]
    if len(baskets) == 3:
        baskets.sort(key=lambda r: r.center[0])
        ctx.facts['baskets'] = {s: dict(xy=np.asarray(b.center[:2], float), top_z=float(b.top_z), row=b)
                                for s, b in zip(SIDES, baskets)}
    if ctx.facts.get('baskets') is None:
        ctx.facts['survey_fail'] += 1
        status = FAIL if ctx.facts['survey_fail'] >= int(P(ctx, 'max_survey_fail', 3)) else UNKNOWN
        return NodeResult(status, 'baskets_not_observed', dict(n_baskets=len(baskets), n=len(rows)))
    ctx.facts['survey_fail'] = 0
    bk = ctx.facts['baskets']
    loose, placed = [], []
    mis_prev, mis_cur, pending = ctx.facts.get('mis_prev', []), [], 0
    need_confirm = bool(P(ctx, 'confirm_misplaced', True))
    assign = _assignment(ctx)
    for r in objects:
        cat = norm_category(r.attributes.get('category') or r.label, list(assign)) if assign else None
        side = assign.get(cat) if cat else None
        if side is None:
            side = str(r.attributes.get('basket', '')).lower().strip()
        if side not in SIDES:
            continue
        xy = np.asarray(r.center[:2], float)
        inside = [s_ for s_, b in bk.items() if _xy_inside(xy, b['row'])]
        row = dict(row=r, side=side, xy=xy, label=r.label, category=cat or r.attributes.get('category'),
                   where=inside[0] if inside else 'table')
        if not inside:
            loose.append(row)
        elif inside[0] != side and not bool(P(ctx, 'remove_misplaced', not _zero_api(ctx))):
            placed.append(row)       # zero-API: in-basket SAM3 categories are unreliable; never take objects out
        elif inside[0] != side:
            # in the wrong basket: spoils that basket -> take it out again, but only when the previous survey
            # also saw a misplaced object here (one survey's category label can be wrong)
            mis_cur.append(xy)
            if not need_confirm or any(np.linalg.norm(xy - p) < .05 for p in mis_prev):
                row['misplaced'] = True
                loose.append(row)
            else:
                pending += 1
                placed.append(row)
        else:
            placed.append(row)
    if _zero_api(ctx):
        _dropped_misplaced(ctx, loose, placed, assign)
    _identify(ctx, [o for o in loose if not o.get('misplaced')], assign)
    ctx.facts['loose'] = loose
    ctx.facts['mis_prev'] = mis_cur
    ctx.facts['mis_pending'] = pending
    ctx.log('lean_survey', mis_pending=pending, n_rows=len(rows), n_baskets=len(baskets), n_loose=len(loose),
            placed=[(o['category'], o['side']) for o in placed],
            loose=[dict(label=o['label'], cat=o['category'], side=o['side'], xy=o['xy'].round(3).tolist(),
                        where=o['where'],
                        h=round(float(o['row'].geometry['height']), 3), w=round(float(o['row'].geometry['width']), 3))
                   for o in loose],
            baskets={s: dict(xy=b['xy'].round(3).tolist(), top_z=round(b['top_z'], 3)) for s, b in bk.items()})
    return NodeResult(PASS, evidence=dict(n_loose=len(loose)))


def _dropped_misplaced(ctx, loose, placed, assign):
    """Zero-API misplaced detection, driven by the controller's own drop events (no global trust in in-basket SAM3
    categories). After a 'dropped_in_carry' whose object did not reappear loose on the table, the objects that NEWLY
    appeared in a basket other than the dropped category's basket (no in-basket object within 5 cm there in the
    previous survey) are compared: the one whose fused SAM3 score favours the dropped category over that basket's
    own category is taken out again (marked misplaced, with the dropped category)."""
    drops = ctx.facts.setdefault('drops', [])
    prev = ctx.facts.get('bk_prev', [])
    rad = float(P(ctx, 'match_radius', .04))
    known = [k for k in ctx.facts.get('known', []) if k.get('state') != 'placed']
    fresh_loose = [o for o in loose if not any(np.linalg.norm(o['xy'] - k['xy']) < rad for k in known)]
    new_in = [r for r in placed if not any(w == r['where'] and np.linalg.norm(r['xy'] - xy) < .05 for w, xy in prev)]
    by_side = {s_: c for c, s_ in assign.items()}
    notes = []
    for dr in list(drops):
        dr['age'] = dr.get('age', 0) + 1
        if any(o['category'] == dr['cat'] for o in fresh_loose):
            drops.remove(dr)
            notes.append(dict(cat=dr['cat'], resolved='loose'))
            continue
        best, gain = None, float(P(ctx, 'drop_min_gain', 0.))
        for r in new_in:
            if r['where'] == dr['side'] or r.get('misplaced'):
                continue
            f = dict(r['row'].attributes.get('fused') or {})
            g = float(f.get(dr['cat'], 0.)) - float(f.get(by_side.get(r['where']), 0.))
            if g > gain:
                best, gain = r, g
        if best is not None:
            placed.remove(best)
            best.update(misplaced=True, category=dr['cat'], side=dr['side'])
            loose.append(best)
            new_in.remove(best)
            drops.remove(dr)
            notes.append(dict(cat=dr['cat'], resolved='in_basket', where=best['where'], gain=round(gain, 3),
                              xy=best['xy'].round(3).tolist()))
        elif dr['age'] >= int(P(ctx, 'drop_max_age', 2)):
            drops.remove(dr)
            notes.append(dict(cat=dr['cat'], resolved='expired'))
    ctx.facts['bk_prev'] = [(r['where'], r['xy'].copy()) for r in placed] + \
        [(r['where'], r['xy'].copy()) for r in loose if r.get('misplaced')]
    if notes or drops:
        ctx.log('lean_drop_check', notes=notes, pending=[d['cat'] for d in drops], n_new_in=len(new_in),
                n_fresh_loose=len(fresh_loose))


def _assignment(ctx):
    a = ctx.facts.get('assign')
    if a is None:
        a = parse_assignment(ctx.instruction)
        a = {c: s for c, s in a.items() if s in SIDES}
        ctx.facts['assign'] = a
        ctx.log('lean_assignment', pairs=a, instruction=str(ctx.instruction))
    return a


def _identify(ctx, loose, assign):
    """Identity across surveys: a loose object within match_radius of a known object keeps the known (verified)
    category; the others get ONE close-up verification call (numbered tiles + depth sizes) and become known."""
    known = ctx.facts.setdefault('known', [])
    rad = float(P(ctx, 'match_radius', .04))
    pairs = sorted(((float(np.linalg.norm(o['xy'] - k['xy'])), i, j) for i, o in enumerate(loose)
                    for j, k in enumerate(known) if k['state'] != 'placed'), key=lambda t: t[0])
    used_o, used_k = set(), set()
    for d, i, j in pairs:
        if d > rad or i in used_o or j in used_k:
            continue
        used_o.add(i)
        used_k.add(j)
        k = known[j]
        o = loose[i]
        o['kid'] = j
        if k.get('cat') in assign and k['cat'] != o['category']:
            o['survey_category'] = o['category']
            o['category'], o['side'] = k['cat'], assign[k['cat']]
        if k.get('dragged'):
            o['dragged'] = True
        k['xy'] = o['xy'].copy()
    new = [o for i, o in enumerate(loose) if i not in used_o]
    if new and assign and P(ctx, 'verify', True) and not _zero_api(ctx):
        try:
            _verify(ctx, new, assign)
        except Exception as exc:  # noqa: BLE001 - verification is optional: keep the survey categories
            ctx.log('lean_verify', error=f'{type(exc).__name__}: {exc}'[:200])
    for o in new:
        o['kid'] = len(known)
        known.append(dict(xy=o['xy'].copy(), cat=o['category'], state='loose', label=o['label']))


def _verify(ctx, items, assign):
    from PIL import Image, ImageDraw
    cats = list(assign)
    f = ctx.perception._last
    if f is None or 'rgb' not in f or any(getattr(o['row'], 'frame', f['frame']) != f['frame'] for o in items):
        ctx.log('lean_verify', skipped='frame_mismatch')
        return
    tile, cols = int(P(ctx, 'verify_tile', 200)), 4
    rows = (len(items) + cols - 1) // cols
    canvas = Image.new('RGB', (cols * tile, rows * tile), (255, 255, 255))
    draw = ImageDraw.Draw(canvas)
    rgb = Image.fromarray(f['rgb'])
    W, H = rgb.size
    for k, o in enumerate(items):
        x0, y0, x1, y1 = [float(v) for v in o['row'].box_xyxy]
        cx, cy = .5 * (x0 + x1), .5 * (y0 + y1)
        half = max(x1 - x0, y1 - y0) * .5 * 1.6 + 6
        crop = rgb.crop((int(max(0, cx - half)), int(max(0, cy - half)), int(min(W, cx + half)), int(min(H, cy + half))))
        sc = (tile - 24) / max(crop.size)
        crop = crop.resize((max(1, int(crop.size[0] * sc)), max(1, int(crop.size[1] * sc))), Image.BICUBIC)
        ox, oy = (k % cols) * tile, (k // cols) * tile
        canvas.paste(crop, (ox + 12, oy + 20))
        draw.rectangle([ox, oy, ox + tile - 1, oy + tile - 1], outline=(0, 0, 0))
        draw.text((ox + 4, oy + 3), str(k + 1), fill=(255, 0, 0))
    path = f['directory'] / 'verify_tiles.png'
    canvas.save(path)
    ext = [np.asarray(o['row'].geometry['extent'], float) for o in items]
    sizes = '; '.join(f'tile {k + 1}: about {100 * e[0]:.0f} x {100 * e[1]:.0f} cm footprint, '
                      f'{100 * e[2]:.0f} cm tall' for k, (o, e) in enumerate(zip(items, ext)))
    prompt = (
        f'The attached image ({canvas.size[0]}x{canvas.size[1]} px) shows {len(items)} numbered tiles; each tile is an '
        'enlarged close-up crop of one small object lying on a wooden table (a robot sorting task). '
        f'Every object is exactly one of these categories: {", ".join(cats)}.\n'
        f'Depth-measured sizes: {sizes}.\n'
        'The crops are taken from far above, so a printed or light-coloured item can look like a wrapper: use the '
        'measured height as strong evidence (e.g. a chocolate bar is a flat wrapped bar about 1 cm thick, so an '
        'item several cm tall is not a chocolate bar; a toy car is low and longer than wide; a watch has a band; '
        'a pepper is a round glossy vegetable; a wooden toy is a carved figure).\n'
        'Classify each tile by what kind of object it is (shape, material, size), not by colour. Return JSON '
        '{"tiles": [{"index": tile number, "category": one of the categories, "reason": few words}]}.\n'
        + IMAGE_CONTRACT)
    try:
        ans = ctx.agent.ask('lean_verify', prompt, images=[str(path)], schema={'type': 'object', 'required': ['tiles']})
    except Exception as exc:  # noqa: BLE001 - semantic service unavailable: keep the survey categories
        ctx.log('lean_verify', error=str(exc)[:200])
        return
    changes = []
    for row in (ans or {}).get('tiles') or []:
        try:
            k = int(row.get('index')) - 1
        except (TypeError, ValueError, AttributeError):
            continue
        cat = norm_category(row.get('category'), cats)
        if 0 <= k < len(items) and cat is not None:
            o = items[k]
            if cat != o['category']:
                changes.append((o['label'], o['category'], cat, str(row.get('reason', ''))[:80]))
                o['survey_category'] = o['category']
                o['category'], o['side'] = cat, assign[cat]
            o['verified'] = True
    ctx.log('lean_verify', n=len(items), changes=changes)


def _arms_for(obj):
    near = 'left' if obj['xy'][0] < 0 else 'right'
    far = 'right' if near == 'left' else 'left'
    return {'left': ['left', 'right'], 'right': ['right', 'left'], 'middle': [near, far]}[obj['side']]


def _route(ctx):
    """PASS -> up to one task per arm (run concurrently); FAIL -> nothing left / budget reserve -> finish;
    UNKNOWN -> re-survey once to confirm a suspected misplaced object."""
    mo = ctx.facts['motion']
    reserve = int(P(ctx, 'home_reserve', 50))
    per_obj = int(P(ctx, 'min_actions_per_object', 80))
    if ctx.remaining_actions() < reserve + per_obj:
        return NodeResult(FAIL, 'budget_reserve')
    max_try = int(P(ctx, 'max_attempts_per_spot', 2))
    def _cands(cap):
        out = []
        for o in ctx.facts.get('loose', []):
            n = sum(1 for a in ctx.facts['attempts'] if np.linalg.norm(a - o['xy']) < .05)
            if n >= (int(P(ctx, 'max_attempts_misplaced', 1)) if o.get('misplaced') else cap):
                continue
            dist = float(np.linalg.norm(o['xy'] - ctx.facts['baskets'][o['side']]['xy']))
            out.append((n, 0 if o.get('misplaced') else 1, dist, o))
        return out
    cands = _cands(max_try)
    if not cands and ctx.facts.get('loose'):
        # every loose object used its attempts but budget is left (dev3 it12: gave up at 640/1100 actions):
        # keep trying (incl. a rim drag) instead of going home with an incomplete basket
        cands = _cands(max_try + int(P(ctx, 'extra_attempts', 3)))
    cands.sort(key=lambda c: (c[0], c[1], c[2]))
    pair = bool(P(ctx, 'parallel', True)) and ctx.remaining_actions() >= reserve + int(P(ctx, 'pair_actions', 130))
    tasks, avoid, no_plan = {}, [], []
    n_planned, max_plans = 0, int(P(ctx, 'max_plans_per_route', 6))
    for n, _, _, o in cands:
        if len(tasks) >= (2 if pair else 1) or (tasks and n_planned >= max_plans):
            break
        n_planned += 1
        t = _plan(ctx, mo, dict(o, attempt=n), _arms_for(o), avoid=avoid)
        if t is None:
            no_plan.append(o)
            continue
        if t['arm'] in tasks:
            continue                      # its arm is busy this round: next round
        if tasks and _conflict(mo, list(tasks.values())[0], t):
            continue                      # sweeps would cross the other arm's: next round
        tasks[t['arm']] = t
        avoid += [o['xy'], t['dest_xy']]
    if pair and len(tasks) == 1:          # the idle arm: anything it can deliver directly
        free = [a for a in mo.io.arms if a not in tasks][0]
        busy = list(tasks.values())[0]
        for n, _, _, o in cands:
            if o is busy['obj'] or any(o is x for x in no_plan) or np.linalg.norm(o['xy'] - busy['obj']['xy']) < .05:
                continue
            t = _plan(ctx, mo, dict(o, attempt=n), [free], avoid=avoid)
            if t is not None and t['mode'] == 'relay' and t['gp']['tilt'] > 0:
                t = None
            if t is not None and not _conflict(mo, busy, t):
                tasks[free] = t
                break
    for o in no_plan:
        ctx.facts['attempts'].append(o['xy'].copy())
        ctx.log('lean_act', status=FAIL, cause='no_ik', label=o['label'], side=o['side'], xy=o['xy'].round(3).tolist())
    if not tasks:
        if no_plan:
            return NodeResult(UNKNOWN, 'no_ik', dict(n=len(no_plan)))
        if ctx.facts.get('mis_pending') and not ctx.facts.get('rechecked'):
            ctx.facts['rechecked'] = True
            return NodeResult(UNKNOWN, 'confirm_misplaced')
        if P(ctx, 'final_check', True) and not ctx.facts.get('final_checked') and \
                ctx.remaining_actions() >= int(P(ctx, 'home_reserve', 50)) + int(P(ctx, 'min_actions_per_object', 105)):
            ctx.facts['final_checked'] = True        # one more careful look before going home (missed flat objects)
            ctx.facts['final_check_pending'] = True
            return NodeResult(UNKNOWN, 'final_check')
        return NodeResult(FAIL, 'nothing_left', dict(n_loose=len(ctx.facts.get('loose', []))))
    queues = {a: [t] for a, t in tasks.items()}
    if P(ctx, 'queue', True):
        _extend_queues(ctx, mo, queues, cands, no_plan, avoid)
    ctx.facts['tasks'] = queues
    return NodeResult(PASS, evidence=dict(tasks={a: [dict(mode=t['mode'], label=t['obj']['label'], side=t['obj']['side'],
                                                          xy=t['obj']['xy'].round(3).tolist()) for t in q]
                                                 for a, q in queues.items()}))


def _extend_queues(ctx, mo, queues, cands, no_plan, avoid):
    """Follow-up tasks per arm from the SAME survey (the arm goes from one release straight to the next
    pregrasp; the next survey checks them all). Direct deliveries first, then top-down relays."""
    reserve = int(P(ctx, 'home_reserve', 50))
    per_obj = int(P(ctx, 'min_actions_per_object', 105))
    qlen = int(P(ctx, 'queue_len', 2))
    sep = float(P(ctx, 'queue_sep', .07))
    taken = [t['obj'] for q in queues.values() for t in q]
    for mode in ('direct', 'relay'):
        for arm in list(queues):
            q = queues[arm]
            for n, _, _, o in cands:
                if len(q) >= qlen:
                    break
                n_relay = sum(1 for qq in queues.values() for t in qq if t['mode'] == 'relay')
                if ctx.remaining_actions() < reserve + per_obj * (len(q) + 1 + n_relay):
                    break
                if any(o is x for x in taken) or any(o is x for x in no_plan) or o.get('misplaced') or \
                        any(np.linalg.norm(o['xy'] - x['xy']) < sep for x in taken):
                    continue
                t = _plan(ctx, mo, dict(o, attempt=n), [arm], avoid=avoid, direct_only=(mode == 'direct'))
                if t is None or t['mode'] not in (mode, 'drag') or (t['mode'] == 'relay' and t['gp']['tilt'] > 0):
                    continue
                q.append(t)
                taken.append(o)
                avoid += [o['xy'], t['dest_xy']]


def _conflict(mo, t1, t2):
    """Predicted XY interference of two tasks. 'full': obj -> dest sweeps (incl. arm lines) must stay apart, so two
    deliveries to the same basket or crossing relays never pair. 'pick': only the two grasps (object points, arm
    lines) must stay apart; the carries are serialised at run time by Motion._clear (sweep reservations)."""
    if P(mo.ctx, 'pair_conflict', 'pick') == 'pick':
        o1, o2 = t1['obj']['xy'], t2['obj']['xy']
        return mo.interferes(t1['arm'], o1, o1, t2['arm'], o2, o2)
    return mo.interferes(t1['arm'], t1['obj']['xy'], t1['dest_xy'], t2['arm'], t2['obj']['xy'], t2['dest_xy'])


def _plan(ctx, mo, obj, arms, avoid=(), direct_only=False):
    """Grasp + delivery plan: the first arm (in ``arms`` order) that can deliver directly, else a table relay by
    the first arm that can grasp it. Outer baskets are delivered only by their own-side arm with a top-down grasp."""
    if (obj.get('attempt', 0) == 0 or obj.get('attempt', 0) >= int(P(ctx, 'max_attempts_per_spot', 2))) and \
            _drag_needed(ctx, obj) is not None:
        g = obj['row'].geometry
        key = (tuple(arms), int(round(g['center'][0] * 200)), int(round(g['center'][1] * 200)),
               int(round(float(g['top_z']) * 400)))
        t = _cached(ctx, 'drag', key, lambda: _drag_plan(ctx, mo, obj, arms))
        if t is not None:
            return dict(t, obj=obj)
    side = obj['side']
    bk = ctx.facts['baskets'][side]
    relays = []
    tilt_ok = float(P(ctx, 'tilt_direct_max', 25)) if obj.get('attempt', 0) == 0 and not obj.get('misplaced') else 0.
    for arm in arms:
        gp = _grasp_plan(ctx, mo, arm, obj)
        if gp is None:
            continue
        if side in ('left', 'right') and (arm != side or gp['tilt'] > tilt_ok):
            dp = None
        else:
            dp = _basket_plan(ctx, mo, arm, bk, gp['bottom_offset'])
        if dp is not None:
            return dict(arm=arm, mode='direct', gp=gp, dp=dp, obj=obj, dest_xy=np.asarray(bk['xy'], float))
        if not direct_only:
            if gp['tilt'] > 0:            # a relay grasp should be the easy top-down one: try it at 0 deg only
                gp0 = _grasp_plan(ctx, mo, arm, obj, tilts=[0])
                gp = gp0 if gp0 is not None else gp
            rxy = _relay_xy(ctx, side, avoid)
            rz = gp['table_z'] + .015 + gp['bottom_offset']
            rr = _cached(ctx, 'relay', (arm, int(round(rxy[0] * 100)), int(round(rxy[1] * 100)), int(round(rz * 200))),
                         lambda: reach(mo, arm, [rxy[0], rxy[1], rz], [0, 25, 45], max_found=1))
            if rr is not None:
                relays.append(dict(arm=arm, mode='relay', gp=gp, dp=dict(drop=rr, travel=None), obj=obj, dest_xy=rxy))
    # relay: prefer a top-down grasp, then the arm nearer the object
    relays.sort(key=lambda t: (t['gp']['tilt'] > 0,
                               np.linalg.norm(mo.io.base_transform(t['arm'])[:2, 3] - obj['xy'])))
    return relays[0] if relays else None


def _cached(ctx, name, key, fn):
    """Plans are solved from the park joints (both arms are parked whenever route plans), so a plan for the
    same geometry is reused across rounds (native IK is slow: ~40 s/route uncached)."""
    c = ctx.facts.setdefault('plan_cache', {}).setdefault(name, {})
    if key not in c:
        c[key] = fn()
    return c[key]


def _grasp_plan(ctx, mo, arm, obj, tilts=None):
    g = obj['row'].geometry
    key = (arm, int(round(g['center'][0] * 200)), int(round(g['center'][1] * 200)), int(round(float(g['top_z']) * 400)),
           tuple(np.round(np.asarray(g['short_axis'], float)[:2], 1)), min(obj.get('attempt', 0), 2), tuple(tilts or ()))
    return _cached(ctx, 'grasp', key, lambda: _grasp_plan_raw(ctx, mo, arm, obj, tilts))


def _rim_gap(ctx, obj):
    """Gap (m) between the object's footprint and the nearest basket wall, and the unit direction from that
    basket toward the object (table plane); (None, None) without baskets."""
    g = obj['row'].geometry
    c0 = np.asarray(g['center'][:2], float)
    la, sa = np.asarray(g['long_axis'], float)[:2], np.asarray(g['short_axis'], float)[:2]
    L, Wd = float(g['extent'][0]), float(g['extent'][1])
    best = (None, None)
    for b in (ctx.facts.get('baskets') or {}).values():
        bg = b['row'].geometry
        axes = np.asarray(bg['axes'], float)[:2, :2]
        half = np.asarray(bg['extent'][:2], float) / 2
        d = c0 - np.asarray(bg['center'][:2], float)
        loc = d @ axes
        e = np.abs(loc) - half
        if np.all(e <= 0):
            continue
        v = axes @ (np.sign(loc) * np.maximum(e, 0.))
        dist = float(np.linalg.norm(v))
        n = v / max(dist, 1e-9)
        hx = abs(float(la @ n)) * L / 2 + abs(float(sa @ n)) * Wd / 2
        gap = dist - hx
        if best[0] is None or gap < best[0]:
            best = (gap, n)
    return best


def _grasp_plan_raw(ctx, mo, arm, obj, tilts=None):
    if tilts is None and obj.get('category') in (P(ctx, 'top_first_cats', ['wooden_toy']) or []):
        # tall figures held by a tilted hand slip (DEV it9-it12: tilted 13/29 delivered, top-down 50/59):
        # top-down whenever it is feasible (incl. next to a rim), tilted only as a fallback
        gp = _grasp_plan_raw(ctx, mo, arm, obj, tilts=[0])
        if gp is not None:
            return gp
    g = obj['row'].geometry
    near_rim = False
    if tilts is None and P(ctx, 'rim_tilt_first', True):
        gap, n = _rim_gap(ctx, obj)
        # a hand coming straight down next to a basket wall hits the rim: lean the hand away from the wall
        # (tilt toward the wall along the long axis) when the object's long axis points at the wall
        if gap is not None and gap < float(P(ctx, 'rim_gap', .035)) and \
                abs(float(np.asarray(g['long_axis'], float)[:2] @ n)) > .5:
            near_rim = True
            tilts = P(ctx, 'rim_tilts', [25, 0, 45])
    sp = g.get('support_plane') or {}
    table_z = float(sp['z_at_center']) if sp.get('source') == 'live_depth_ransac' else float(g['bottom_z'])
    top = float(g['top_z'])
    h = max(top - table_z, .005)
    if obj.get('attempt', 0) >= 1:      # retry at the same spot: grasp deeper (empty grasps were shallow misses)
        z = top - min(float(P(ctx, 'retry_grasp_depth', .035)), .6 * h)
    else:
        z = top - min(float(P(ctx, 'grasp_depth', .022)), .5 * h)
    xy = np.asarray(g['center'][:2], float)
    short = np.asarray(g['short_axis'], float)
    rotate = obj.get('attempt', 0) == 1 and P(ctx, 'retry_rotate', True) and not near_rim
    if rotate:                          # 1st retry at a spot: other closing axis
        short = np.asarray(g['long_axis'], float).copy()
    best = None
    b = mo.io.base_transform(arm)[:3, 3]
    long_axis = np.asarray(g['long_axis'], float)
    if rotate:                          # tilt direction stays normal to the jaw
        long_axis = np.asarray(g['short_axis'], float).copy()
    if near_rim:                        # tilt toward the wall: the hand body leans away from it
        n = _rim_gap(ctx, obj)[1]
        if long_axis[:2] @ n > 0:
            long_axis = -long_axis
    elif long_axis[:2] @ (xy - b[:2]) < 0:
        long_axis = -long_axis
    options = [(sign, tilt) for tilt in (tilts or P(ctx, 'grasp_tilts', [0, 25, 45])) for sign in (1., -1.)]
    first_tilt = options[0][1]
    for sign, tilt in options:
        if best is not None and tilt != first_tilt:
            break
        R = mo.sk._down_frame(sign * short, tilt, long_axis)
        T = mo.pose([xy[0], xy[1], z], R)
        try:
            lowest = mo.io.hand_min_z(arm, T)
            if lowest < table_z + .004:
                T[2, 3] += table_z + .004 - lowest
            pre = T.copy()
            pre[:3, 3] -= R[:3, 0] * float(P(ctx, 'pre_height', .08))
            q_pre = mo.ik(arm, pre)
            mo.ik(arm, T)
        except (IKFailure, ValueError):
            continue
        cost = float(np.max(np.abs(q_pre - mo.io.joints(arm))))
        if best is None or cost < best[0]:
            best = (cost, dict(T=T, pre=pre, q_pre=q_pre, R=R, table_z=table_z, tilt=tilt, near_rim=near_rim,
                               bottom_offset=float(T[2, 3] - table_z)))
    return None if best is None else best[1]


def _basket_plan(ctx, mo, arm, bk, bottom_offset):
    key = (arm, int(round(bk['xy'][0] * 100)), int(round(bk['xy'][1] * 100)), int(round(bottom_offset * 200)))
    return _cached(ctx, 'basket', key, lambda: _basket_plan_raw(ctx, mo, arm, bk, bottom_offset))


def _basket_plan_raw(ctx, mo, arm, bk, bottom_offset):
    """Travel point above the basket front rim, then drop pose over the basket centre (pitch family)."""
    rim = bk['top_z']
    thetas = P(ctx, 'drop_thetas', [0, 25, 45, 65, 90])
    b = mo.io.base_transform(arm)[:3, 3]
    h = bk['xy'] - b[:2]
    h /= np.linalg.norm(h)
    drop = None
    for th in thetas:
        hang = bottom_offset * np.cos(np.radians(th))
        xy = bk['xy'] - h * float(P(ctx, 'drop_back', .03)) * np.sin(np.radians(th)) \
            - np.array([0., float(P(ctx, 'drop_front', .02))])     # toward the robot: drops spilled past the rear rim
        z = rim + float(P(ctx, 'drop_clearance', .05)) + hang
        drop = reach(mo, arm, [xy[0], xy[1], z], [th], max_found=1, h=h)
        if drop is not None:
            break
    if drop is None:
        return None
    travel = None
    dx = drop['T'][:3, 3]
    for up in P(ctx, 'travel_ups', [.07, .045]):   # straight above the drop pose, then a vertical lower
        travel = reach(mo, arm, [dx[0], dx[1], dx[2] + up], [drop['theta'], 0, 25, 45, 65], max_found=1, h=h)
        if travel is not None:
            break
    return dict(drop=drop, travel=travel)


def _relay_xy(ctx, dst_side, avoid=()):
    sgn = -1. if dst_side == 'left' else 1.
    others = [o['xy'] for o in ctx.facts.get('loose', [])] + [np.asarray(v, float) for v in avoid]
    spots = [np.array([sgn * .08, -.14]), np.array([sgn * .12, -.22]), np.array([sgn * .04, -.11]),
             np.array([sgn * .16, -.10]) if not P(ctx, 'relay_off_rim', True) else np.array([sgn * .14, -.17])]
    return max(spots, key=lambda s: min([np.linalg.norm(s - o) for o in others] + [1.]))


def _resolve(mo, arm, plan):
    """Re-solve a planned pose from the CURRENT joints (native IK is seeded there); planned q as fallback."""
    try:
        return mo.ik_guarded(arm, plan['T'])
    except IKFailure:
        return plan['q']


def _footprint_min_y(row):
    g = row.geometry
    axes = np.asarray(g['axes'], float)
    half = np.asarray(g['extent'][:2], float) / 2
    c = np.asarray(g['center'][:2], float)
    return min(float((c + axes[:2, 0] * sx * half[0] + axes[:2, 1] * sy * half[1])[1])
               for sx in (-1, 1) for sy in (-1, 1))


def _detour(ctx, mo, arm, side, T_dest):
    """A held object never flies over ANOTHER basket (a drop there spoils it): when the straight carry would,
    return a waypoint in front of the baskets at the target's x (else None)."""
    bk = ctx.facts['baskets']
    p0 = mo.io.tcp(arm)[:3, 3]
    p1 = np.asarray(T_dest, float)[:3, 3]
    others = [b['row'] for s, b in bk.items() if s != side]
    m = float(P(ctx, 'detour_margin', .02))

    def crosses(a, b):
        return any(_xy_inside(a[:2] * (1 - u) + b[:2] * u, r, m) for u in np.linspace(0, 1, 25) for r in others)
    if not crosses(p0, p1):
        return None
    front = min(_footprint_min_y(b['row']) for b in bk.values()) - float(P(ctx, 'detour_front', .04))
    wy = min(float(p0[1]), front)
    z = max(float(p0[2]), float(p1[2]))
    for R in (mo.io.tcp(arm)[:3, :3], np.asarray(T_dest, float)[:3, :3]):
        Wp = Motion.pose([p1[0], wy, z], R)
        try:
            mo.ik(arm, Wp)
            return Wp
        except IKFailure:
            continue
    return None


def _known(ctx, obj, **kw):
    kid = obj.get('kid')
    known = ctx.facts.get('known', [])
    if kid is not None and 0 <= kid < len(known):
        known[kid].update(kw)


def _drag_needed(ctx, obj):
    """Flat object lying against a basket wall with its long axis along the wall: the wall-side finger cannot get
    between object and wall (dev3 it11: 3x empty grasps at the middle-basket front rim). Returns the unit
    direction away from the wall, or None."""
    if not P(ctx, 'rim_drag', True) or obj.get('dragged') or obj.get('where') != 'table':
        return None
    g = obj['row'].geometry
    sp = g.get('support_plane') or {}
    table_z = float(sp['z_at_center']) if sp.get('source') == 'live_depth_ransac' else float(g['bottom_z'])
    if float(g['top_z']) - table_z > float(P(ctx, 'rim_drag_max_h', .03)):
        return None
    gap, n = _rim_gap(ctx, obj)
    if gap is None or gap > float(P(ctx, 'rim_drag_gap', .02)):
        return None
    if abs(float(np.asarray(g['long_axis'], float)[:2] @ n)) > .5:
        return None                       # long axis points at the wall: the rim-tilt grasp handles it
    return n


def _drag_plan(ctx, mo, obj, arms):
    """Closed fingertips pressed lightly on the object's top, slid ``rim_drag_dist`` away from the wall."""
    n = _drag_needed(ctx, obj)
    if n is None:
        return None
    g = obj['row'].geometry
    sp = g.get('support_plane') or {}
    table_z = float(sp['z_at_center']) if sp.get('source') == 'live_depth_ransac' else float(g['bottom_z'])
    top = float(g['top_z'])
    xy = np.asarray(g['center'][:2], float)
    dist = float(P(ctx, 'rim_drag_dist', .05))
    press = float(P(ctx, 'rim_drag_press', .004))
    short, long_axis = np.asarray(g['short_axis'], float), np.asarray(g['long_axis'], float)
    for arm in arms:
        b = mo.io.base_transform(arm)[:3, 3]
        la = long_axis if long_axis[:2] @ (xy - b[:2]) >= 0 else -long_axis
        stage, err = 'frame', None
        opts = []
        for tilt in P(ctx, 'rim_drag_tilts', [0, 25, 45]):
            for d in ([la] if tilt == 0 else [-np.r_[n[:2], 0.], la, -la]):
                d = np.asarray(d, float)
                c = np.cross([0., 0., 1.], d)
                c = c / max(np.linalg.norm(c), 1e-9) if tilt else short
                opts += [(tilt, c, d), (tilt, -c, d)]
        for tilt, c, d in opts:
            R = mo.sk._down_frame(c, float(tilt), d)
            T = mo.pose([xy[0], xy[1], top + .02], R)
            try:
                T[2, 3] += (top - press) - mo.io.hand_min_z(arm, T)
                if mo.io.hand_min_z(arm, T) < table_z + .004:
                    stage = 'table'
                    continue
                pre = T.copy()
                pre[:3, 3] -= R[:3, 0] * float(P(ctx, 'rim_drag_pre', .04))   # vertical reach is short near the middle
                end = T.copy()
                end[:2, 3] += n[:2] * dist
                up = end.copy()
                up[:3, 3] -= R[:3, 0] * float(P(ctx, 'rim_drag_pre', .04))
                stage = 'pre'
                q_pre = mo.ik(arm, pre)
                stage = 'press'
                mo.ik(arm, T)
                stage = 'end'
                mo.ik(arm, end)
                stage = 'up'
                mo.ik(arm, up)
            except (IKFailure, ValueError) as exc:
                err = f'{type(exc).__name__}: {exc}'[:200]
                continue
            return dict(arm=arm, mode='drag', gp=dict(T=T, pre=pre, q_pre=q_pre, R=R, table_z=table_z, tilt=tilt,
                                                      bottom_offset=0.), dp=dict(drop=dict(theta=0), travel=None),
                        end=end, up=up, obj=obj, dest_xy=end[:2, 3].copy(), n=n[:2].copy())
        ctx.log('lean_drag_noplan', arm=arm, label=obj['label'], xy=obj['xy'].round(3).tolist(), stage=stage, error=err)
    return None


def _drag_gen(ctx, task, park_after=False):
    mo, obj, arm = ctx.facts['motion'], task['obj'], task['arm']
    c0 = mo.io.action_count
    ctx.facts['attempts'].append(obj['xy'].copy())
    fine, empty = float(P(ctx, 'fine_step', .07)), float(P(ctx, 'empty_step', .22))
    n_ev = len(mo.events)
    ev = dict(arm=arm, mode='drag', label=obj['label'], side=obj['side'], cat=obj.get('category'),
              xy=obj['xy'].round(3).tolist(), where=obj['where'], grasp_tilt=task['gp']['tilt'], drop_theta=0, travel=False,
              park_after=park_after, n=np.round(task['n'], 3).tolist())
    try:
        yield from mo.hold(arm, 0, 4)
        yield from mo.cmove(arm, task['gp']['pre'], grip={arm: 0}, step=empty, label='drag_approach')
        yield from mo.jmove({arm: mo.ik_near(arm, task['gp']['T'])}, grip={arm: 0}, step=.04, tol=.008,
                            label='drag_press')
        yield from mo.cmove(arm, task['end'], grip={arm: 0}, step=.03, mids=3, bump=0., label='drag_slide',
                            settle=4, keep_rot=True)
        yield from mo.jmove({arm: mo.ik_near(arm, task['up'])}, grip={arm: 1}, step=fine, label='drag_up', settle=0)
    except Exception as exc:  # noqa: BLE001 - any motion error: open, re-park, let the survey decide
        ev.update(error=f'{type(exc).__name__}: {getattr(exc, "diagnostics", exc)}'[:300])
        yield from mo.hold(arm, 1, 2)
        try:
            yield from mo.jmove({arm: ctx.facts['park'][arm]}, grip={arm: 1}, step=float(P(ctx, 'transit_step', .15)))
        except IKFailure:
            yield from mo._raw(arm, ctx.facts['park'][arm], float(P(ctx, 'transit_step', .15)))
        ev['actions'] = mo.io.action_count - c0
        ev['moves'] = mo.events[n_ev:]
        return NodeResult(FAIL, 'motion_failed', ev, actions=ev['actions'])
    _known(ctx, obj, xy=np.asarray(task['dest_xy'], float).copy(), dragged=True)
    ev['actions'] = mo.io.action_count - c0
    ev['moves'] = mo.events[n_ev:]
    return NodeResult(PASS, evidence=ev, actions=ev['actions'])


def _act_gen(ctx, task, park_after=True):
    """Generator: execute one planned task (pick, carry, drop/relay) on task['arm']; re-park the arm only when
    ``park_after`` (otherwise the arm goes straight on to its next task). Evidence 'parked' says where it ended."""
    mo, obj = ctx.facts['motion'], task['obj']
    ctx.facts['attempts'].append(obj['xy'].copy())
    c0 = mo.io.action_count
    side = obj['side']
    arm, gp, dp, mode = task['arm'], task['gp'], task['dp'], task['mode']
    fast, fine = float(P(ctx, 'transit_step', .15)), float(P(ctx, 'fine_step', .07))
    empty = float(P(ctx, 'empty_step', .22))
    carry = float(P(ctx, 'carry_step', .10))
    acc = float(P(ctx, 'held_acc', .03)) or None
    gentle = obj.get('category') in (P(ctx, 'gentle_cats', ['car']) or []) or \
        (gp.get('tilt', 0) > 0 and P(ctx, 'gentle_tilted', True))   # tilted (cross-side) grasps hold weakly
    if gentle:                            # cars slip/swing out of the jaw under hard accelerations: soft ramp,
        acc = float(P(ctx, 'gentle_acc', .015))                    # lower top speed, no stop at waypoints
        carry = float(P(ctx, 'gentle_carry_step', .08))
    if not hasattr(mo, 'v_chain'):
        mo.v_chain, mo.v_carry = set(), {}
    mo.v_carry[arm] = 0.
    if gentle and P(ctx, 'gentle_chain', True):
        mo.v_chain.add(arm)
    else:
        mo.v_chain.discard(arm)
    park = ctx.facts['park']
    ev = dict(arm=arm, mode=mode, label=obj['label'], side=side, cat=obj.get('category'), xy=obj['xy'].round(3).tolist(),
              where=obj['where'], grasp_z=round(float(gp['T'][2, 3]), 4), table_z=round(gp['table_z'], 4),
              grasp_tilt=gp['tilt'], drop_theta=dp['drop']['theta'], travel=dp['travel'] is not None,
              park_after=park_after, relayed=bool(obj.get('relayed')))
    phase = 'approach'
    n_ev = len(mo.events)

    def finish_moves():
        ev['actions'] = mo.io.action_count - c0
        ev['moves'] = mo.events[n_ev:]
    try:
        yield from mo.cmove(arm, gp['pre'], grip={arm: 1}, step=empty, label='approach')
        phase = 'descend'
        yield from mo.jmove({arm: mo.ik_near(arm, gp['T'])}, step=fine, tol=.008, label='descend')
        phase = 'close'
        yield from mo.hold(arm, 0, int(P(ctx, 'gentle_close_actions', 12) if gentle else P(ctx, 'close_actions', 10)))
        phase = 'lift'
        lifted = None
        for dz in P(ctx, 'lift_heights', [.10, .07, .05]):
            lift = gp['T'].copy()
            lift[2, 3] += dz
            try:
                lifted = mo.ik_near(arm, lift)
                break
            except IKFailure:
                continue
        if lifted is None:
            r = reach(mo, arm, gp['T'][:3, 3] + [0, 0, .06], [20, 40, 60], max_found=1)
            lifted = None if r is None else r['q']
        if lifted is None:
            raise IKFailure(dict(reason='lift_unreachable', arm=arm))
        yield from mo.jmove({arm: lifted}, step=fine, label='lift', acc=acc)
        if P(ctx, 'debug_frames', True):
            ctx.perception.observe_wrist(arm, 'lean_after_lift')
        contact = mo.sk._jaw_contact(arm)
        ev['fingers_after_lift'] = np.asarray(mo.io.fingers(arm)).round(4).tolist()
        ev['contact'] = contact
        if contact is False:
            yield from mo.hold(arm, 1, 4)
            if park_after:
                yield from mo.jmove({arm: park[arm]}, grip={arm: 1}, step=fast)
            ev['parked'] = park_after
            finish_moves()
            return NodeResult(FAIL, 'empty_grasp', ev, actions=ev['actions'])
        phase = 'carry'
        dest = (dp['travel'] or dp['drop'])['T']
        if P(ctx, 'carry_detour', True):
            wp = _detour(ctx, mo, arm, side if mode == 'direct' else None, dest)
            if wp is not None:
                ev['detour'] = wp[:3, 3].round(3).tolist()
                yield from mo.cmove(arm, wp, step=carry, mids=int(P(ctx, 'detour_mids', 3)), bump=0., label='detour',
                                    settle=2, tol=.03, acc=acc, keep_rot=True)
        cm = int(P(ctx, 'carry_mids', 2))
        if dp.get('travel') is not None:
            yield from mo.cmove(arm, dp['travel']['T'], q_goal=_resolve(mo, arm, dp['travel']), step=carry, mids=cm,
                                bump=float(P(ctx, 'carry_bump', .05)), label='carry', settle=4, tol=.03, acc=acc)
        phase = 'lower'
        if dp.get('travel') is None:
            yield from mo.cmove(arm, dp['drop']['T'], q_goal=_resolve(mo, arm, dp['drop']), step=carry, mids=cm,
                                bump=float(P(ctx, 'carry_bump', .05)), label='carry', acc=acc)
        else:
            try:
                q_low = mo.ik_near(arm, dp['drop']['T'])
            except IKFailure:
                q_low = _resolve(mo, arm, dp['drop'])
            yield from mo.jmove({arm: q_low}, step=fine, label='lower', acc=acc)
        phase = 'release'
        if mode == 'direct':              # (a relayed object touches the table here: no meaningful reading)
            ev['contact_before_release'] = mo.sk._jaw_contact(arm)
        if P(ctx, 'debug_frames', True):
            ctx.perception.observe('lean_before_release')
        yield from mo.hold(arm, 1, int(P(ctx, 'open_actions', 8)))
        if P(ctx, 'debug_frames', True):
            ctx.perception.observe('lean_after_release')
        phase = 'retreat'
        back = dp['drop']['T'].copy()        # pull the fingers out along their own axis (ring objects hooked a
        back[:3, 3] -= back[:3, 0] * float(P(ctx, 'release_backout', .06))   # finger and were dragged out)
        try:
            yield from mo.jmove({arm: mo.ik_near(arm, back)}, step=fine, settle=0, label='backout')
        except IKFailure:
            ev['backout_ik'] = False
        ring = obj.get('category') in (P(ctx, 'slow_retreat_cats', ['watch']) or [])
        if dp.get('travel') is not None:     # ring objects (watch) can hang on a finger: leave slowly
            yield from mo.jmove({arm: _resolve(mo, arm, dp['travel'])}, step=fine if ring else fast, settle=0,
                                label='retreat')
        else:
            up = dp['drop']['T'].copy()
            up[2, 3] += .06
            try:
                yield from mo.jmove({arm: mo.ik(arm, up)}, step=fast, settle=0)
            except IKFailure:
                ev['retreat_ik'] = False
        if park_after:
            yield from mo.cmove(arm, mo.io.tcp(arm, q=park[arm]), q_goal=park[arm], grip={arm: 1}, step=empty, mids=1,
                                label='park', settle=3, tol=.03)
        ev['parked'] = park_after
    except Exception as exc:  # noqa: BLE001 - any motion error: open, re-park, let the survey decide
        ev.update(error=f'{type(exc).__name__}: {getattr(exc, "diagnostics", exc)}'[:300], phase=phase,
                  moves=mo.events[n_ev:])
        yield from mo.hold(arm, 1, 4)
        try:
            yield from mo.jmove({arm: park[arm]}, grip={arm: 1}, step=fast)
        except IKFailure:                 # clearance wait timed out: park without the check (moving away)
            yield from mo._raw(arm, park[arm], fast)
        ev['parked'] = True
        ev['actions'] = mo.io.action_count - c0
        return NodeResult(FAIL, 'motion_failed', ev, actions=ev['actions'])
    finish_moves()
    if ev.get('contact_before_release') is False:
        if _zero_api(ctx) and obj.get('category') in _assignment(ctx):
            ctx.facts.setdefault('drops', []).append(dict(cat=obj['category'], side=obj['side']))
        return NodeResult(FAIL, 'dropped_in_carry', ev, actions=ev['actions'])
    if mode == 'direct':
        _known(ctx, obj, state='placed')
    else:
        _known(ctx, obj, xy=np.asarray(task['dest_xy'], float).copy(), state='relayed')
    return NodeResult(PASS, evidence=ev, actions=ev['actions'])


def _park_gen(ctx, mo, arm):
    park = ctx.facts['park']
    try:
        yield from mo.cmove(arm, mo.io.tcp(arm, q=park[arm]), q_goal=park[arm], grip={arm: 1},
                            step=float(P(ctx, 'empty_step', .22)), mids=1, label='park', settle=3, tol=.03)
    except IKFailure:
        yield from mo._raw(arm, park[arm], float(P(ctx, 'transit_step', .15)))


def _queue_gen(ctx, arm, queue):
    """Generator: one arm's tasks back to back (release -> next pregrasp, no park in between). Afterwards it
    takes over objects the OTHER arm relayed for it in this round (concurrent handoff: SAM-only relocalisation,
    direct delivery) while the other arm keeps working; parks at the end. Returns [(task, result, kind)]."""
    mo = ctx.facts['motion']
    reserve = int(P(ctx, 'home_reserve', 50))
    per_obj = int(P(ctx, 'min_actions_per_object', 105))
    box, left = ctx.facts['relay_box'], ctx.facts['relays_left']
    other = [a for a in mo.io.arms if a != arm][0]
    done, parked = [], True
    for i, t in enumerate(queue):
        if i > 0 and ctx.remaining_actions() < reserve + per_obj:
            break
        r = yield from (_drag_gen if t['mode'] == 'drag' else _act_gen)(ctx, t, park_after=False)
        done.append((t, r, 'queue'))
        parked = False
        if t['mode'] == 'relay':
            left[arm] -= 1
            if r.status == PASS:
                box.append(dict(task=t, for_arm=other, taken=False))
        if r.cause == 'motion_failed':
            parked = True
            break
    for t in queue[len(done):]:
        if t['mode'] == 'relay':
            left[arm] -= 1
    idle = 0
    while P(ctx, 'handoff', True):
        pend = [m for m in box if m['for_arm'] == arm and not m['taken']]
        if not pend:
            if left[other] <= 0 or idle > int(P(ctx, 'handoff_wait', 300)):
                break
            if not parked:                # wait out of the way (and out of the head view)
                yield from _park_gen(ctx, mo, arm)
                parked = True
            idle += 1
            yield
            continue
        m = pend[0]
        spot = np.asarray(m['task']['dest_xy'], float)[:2]
        if np.linalg.norm(mo.io.tcp(other)[:2, 3] - spot) < float(P(ctx, 'relocate_clear', .15)) and idle < 300:
            idle += 1                     # the relaying hand is still over the spot
            yield
            continue
        m['taken'] = True
        if ctx.remaining_actions() < reserve + per_obj:
            continue
        if np.linalg.norm(mo.io.tcp(arm)[:2, 3] - spot) < float(P(ctx, 'relocate_clear', .15)) and not parked:
            yield from _park_gen(ctx, mo, arm)
            parked = True
        obj = _relocate(ctx, mo, m['task'])
        if obj is None:
            continue
        t = _plan(ctx, mo, obj, [arm], direct_only=True)
        if t is None or t['mode'] != 'direct':
            ctx.log('lean_handoff', label=obj['label'], arm=arm, planned=False)
            continue
        _known(ctx, obj, xy=obj['xy'].copy())
        r = yield from _act_gen(ctx, t, park_after=False)
        done.append((t, r, 'handoff'))
        parked = r.cause == 'motion_failed'
    if not parked:
        yield from _park_gen(ctx, mo, arm)
    return done


def _relocate(ctx, mo, task):
    """SAM-only (no Claude) re-localisation of a relayed object at its relay spot from a fresh head frame: the
    projected box of a small column (object half-length + margin) around the spot is segmented."""
    perc = ctx.perception
    spot = np.asarray(task['dest_xy'], float)[:2]
    old = task['obj']
    g0 = old['row'].geometry
    tz = float(task['gp']['table_z'])
    try:
        f = perc._new_frame('lean_relay_check')
        K, Tc = np.asarray(f['K'], float), np.asarray(f['T_world_camera'], float)
        e0 = np.asarray(g0['extent'], float)
        r = .5 * max(float(e0[0]), float(e0[1])) + float(P(ctx, 'relocate_margin', .01))
        zt = tz + max(float(e0[2]), .02) + .01
        pts = np.array([[spot[0] + dx, spot[1] + dy, z] for dx in (-r, r) for dy in (-r, r) for z in (tz, zt)])
        uv = project(pts, K, Tc)
        h, w = f['depth'].shape
        box = np.clip([uv[:, 0].min(), uv[:, 1].min(), uv[:, 0].max(), uv[:, 1].max()], 0, [w, h, w, h])
        mask, score, _ = perc.segmenter.segment(f['png'], f['rgb_sha256'], box)
        if score < .5 or int(mask.sum()) < 30:
            raise ValueError(f'sam uncertain {score:.2f} {int(mask.sum())}')
        raw = backproject(f['depth'], K, Tc, mask)
        cloud = perc.exclude(raw)
        scene = backproject(f['depth'], K, Tc, ~mask, stride=3)
        support = perc._support(scene, cloud)
        g = infer_geometry(cloud, support, supported=True)
    except Exception as exc:  # noqa: BLE001 - relocalisation failed: the next survey finds it
        ctx.log('lean_relocate', label=old['label'], ok=False, error=f'{type(exc).__name__}: {exc}'[:200])
        return None
    c = np.asarray(g['center'], float)
    d = float(np.linalg.norm(c[:2] - spot))
    in_basket = any(_xy_inside(c[:2], b['row']) for b in ctx.facts['baskets'].values())
    ok = d < float(P(ctx, 'relocate_radius', .06)) and float(g['height']) > .006 and not in_basket
    ctx.log('lean_relocate', label=old['label'], ok=ok, spot=spot.round(3).tolist(), center=c.round(3).tolist(),
            dist=round(d, 3), h=round(float(g['height']), 3), score=round(float(score), 3), frame=f['frame'],
            box=[round(float(v), 1) for v in box])
    if not ok:
        return None
    row = _Row(old['label'], g, dict(old['row'].attributes), [float(v) for v in box], f['frame'])
    obj = dict(old, row=row, xy=c[:2].copy(), where='table', attempt=0, relayed=True)
    obj.pop('misplaced', None)
    return obj


def _handoff(ctx, task):
    """Same-round handoff of a relayed object: the other arm picks it right away (no survey)."""
    mo = ctx.facts['motion']
    if ctx.remaining_actions() < int(P(ctx, 'home_reserve', 50)) + int(P(ctx, 'min_actions_per_object', 105)):
        return None
    recv = [a for a in mo.io.arms if a != task['arm']][0]
    obj = _relocate(ctx, mo, task)
    if obj is None:
        return None
    t = _plan(ctx, mo, obj, [recv], direct_only=True)
    if t is None or t['mode'] != 'direct':
        ctx.log('lean_handoff', label=obj['label'], arm=recv, planned=False)
        return None
    _known(ctx, obj, xy=obj['xy'].copy())
    r = mo.do(_act_gen(ctx, t))
    ctx.log('lean_act', status=r.status, cause=r.cause, paired=1, handoff=True, **{k: v for k, v in r.evidence.items()})
    return dict(arm=recv, status=r.status, cause=r.cause, label=obj['label'], mode='handoff')


def _act(ctx):
    mo, queues = ctx.facts['motion'], ctx.facts['tasks']
    c0 = mo.io.action_count
    queues = dict(queues)
    if P(ctx, 'handoff', True):           # an idle arm joins the round when the other one relays to it
        for a in mo.io.arms:
            if a not in queues and any(t['mode'] == 'relay' for q in queues.values() for t in q):
                queues[a] = []
    ctx.facts['relay_box'] = []
    ctx.facts['relays_left'] = {a: sum(1 for t in queues.get(a, []) if t['mode'] == 'relay') for a in mo.io.arms}
    mo.parallel = len(queues) > 1
    mo.prio = {a: i for i, a in enumerate(queues)}
    out = mo.run({a: _queue_gen(ctx, a, q) for a, q in queues.items()})
    mo.parallel = False
    results = []
    for a in queues:
        for t, r, kind in out.get(a) or []:
            ctx.log('lean_act', status=r.status, cause=r.cause, paired=len(queues), queued=len(queues[a]),
                    handoff=kind == 'handoff', **{k: v for k, v in r.evidence.items()})
            results.append(dict(arm=t['arm'], status=r.status, cause=r.cause, label=t['obj']['label'],
                                mode='handoff' if kind == 'handoff' else t['mode']))
    relayed = [m['task'] for m in ctx.facts['relay_box'] if not m['taken']]
    if P(ctx, 'handoff', True):
        for t in relayed:
            try:
                h = _handoff(ctx, t)
            except BudgetExhausted:
                raise
            except Exception as exc:  # noqa: BLE001 - handoff is an optimisation; the next survey retries
                ctx.log('lean_handoff', error=f'{type(exc).__name__}: {exc}'[:200])
                h = None
            if h is not None:
                results.append(h)
    used = mo.io.action_count - c0
    ok = any(r['status'] == PASS for r in results)
    return NodeResult(PASS if ok else FAIL, None if ok else (results[0]['cause'] if results else 'no_result'),
                      dict(results=results, actions=used), actions=used)


def _finish(ctx):
    mo = ctx.facts.get('motion') or Motion(ctx)
    c0 = mo.io.action_count
    mo.parallel = False
    mo.do(mo.jmove(dict(mo.home_q), grip={a: 1 for a in mo.io.arms}, step=float(P(ctx, 'transit_step', .15)),
                   tol=.01, settle=20))
    mo.do(mo.hold(next(iter(mo.io.arms)), 1, 3))
    return NodeResult(PASS, evidence=dict(actions=mo.io.action_count - c0), actions=mo.io.action_count - c0)


def build_graph(ctx):
    nodes = dict(
        start=Node('start', _start, postcondition='both arms parked outside the head-camera table view'),
        survey=Node('survey', _survey, postcondition='baskets + loose objects with assigned basket'),
        route=Node('route', _route, postcondition='one loose object selected'),
        act=Node('act', _act, postcondition='object picked, carried and dropped over its basket; arm parked'),
        finish=Node('finish', _finish, postcondition='both arms at start joints, grippers open'),
    )
    edges = dict(
        start={PASS: 'survey', FAIL: 'finish', UNKNOWN: 'finish'},
        survey={PASS: 'route', FAIL: 'finish', UNKNOWN: 'survey'},
        route={PASS: 'act', FAIL: 'finish', UNKNOWN: 'survey'},
        act={PASS: 'survey', FAIL: 'survey', UNKNOWN: 'survey'},
        finish={PASS: DONE, FAIL: ABORT, UNKNOWN: ABORT},
    )
    return Graph(task=TASK_ID, nodes=nodes, start='start', edges=edges,
                 max_stagnant_visits=int(ctx.params.get('max_stagnant_visits', 30)),
                 max_transitions=int(ctx.params.get('max_transitions', 200)),
                 description='r0B_lean: park, survey, pick-drop loop with camera re-survey, home')
